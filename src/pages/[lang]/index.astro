---
import Base from '../../layouts/Base.astro';
import Room from '../../components/Room.astro';
import Route from '../../components/Route.astro';
import { T, LANGS, EMAIL, CV, LINKEDIN, type Lang } from '../../lib/content';
export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const h = T[lang].home;
const ab = T[lang].about;
const nav = T[lang].nav;
---
<Base lang={lang} path="/" current="home">
  <div class="wrap hero">
    <h1 class="display">{h.name}</h1>
    <div class="hero-grid">
      <div class="intro-seq">
        <p class="lede">{h.headline}</p>
        <p class="intro">{h.intro}</p>
        <div class="actions hero-actions">
          <a class="btn" href={`mailto:${EMAIL}`}>{h.write}</a>
          <a class="icon-btn" href={LINKEDIN} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9.75h4V21H3V9.75zM9.5 9.75h3.8v1.6h.06c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.77 2.55 4.77 5.87V21h-4v-5.1c0-1.22-.02-2.78-1.8-2.78-1.8 0-2.08 1.35-2.08 2.7V21h-4V9.75z"/></svg></a>
          <a class="icon-btn" href={CV} target="_blank" rel="noopener" aria-label={h.cv}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8l-5-5z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg><span>CV</span></a>
        </div>
      </div>
      <Room lang={lang} />
    </div>

    <h2 class="sec" id="projects">{h.projectsTitle}</h2>
    <ul class="ledger">
      {h.projects.filter((p) => !p.soon).map((p) => (
        <li style="display:contents">
          {p.soon ? (
            <div class="row soon">
              <div>
                <h3>{p.name}</h3>
                <p>{p.line}</p>
              </div>
              <div class="meta mono">
                <span class="state wip">{p.status}</span>
                <span class="muted">{p.since}</span>
              </div>
            </div>
          ) : (
            <a class="row" href={`/${lang}/projects/${p.slug}/`}>
              <div>
                <h3>{p.name}<span class="go" aria-hidden="true">→</span></h3>
                <p>{p.line}</p>
              </div>
              <div class="meta mono">
                <span class:list={['state', p.slug === 'dashboard' && 'priv']}>{p.status}</span>
                <span class="muted">{p.since}</span>
              </div>
            </a>
          )}
        </li>
      ))}
    </ul>

    <h2 class="sec" id="route">{h.routeTitle}</h2>
    <Route lang={lang} />

    <div class="finale">
      <div class="space-stars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <section class="space" id="space" aria-labelledby="space-h">
      <div class="space-in">
        <div class="space-stage" aria-hidden="true">
          <div class="planet"><i class="pl-bands"></i><i class="pl-ring"></i><i class="pl-shade"></i></div>
        </div>
        <p class="mono space-kind">{lang === 'en' ? 'Countdown' : 'Cuenta atrás'}</p>
        <h2 id="space-h">{h.routeNext.headline}</h2>
        <p class="space-lede">{h.routeNext.lede}</p>
        <div class="space-count"><b class="tnum" data-days data-done={h.routeNext.now}>0</b><span class="mono">{h.routeNext.days}</span></div>
      </div>
    </section>

    <section class="close hb">
      <div class="hb-copy">
        <h2>{h.closeTitle}</h2>
        <p>{h.closeText}</p>
      </div>
      <div class="hb-links">
        <span class="hb-pad" aria-hidden="true"><i></i><i></i></span>
        <a class="hb-row main" href={`mailto:${EMAIL}`}><span class="mono">01</span><b>{h.write}</b><small>{EMAIL}</small><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg></a>
        <a class="hb-row" href={LINKEDIN} target="_blank" rel="noopener noreferrer"><span class="mono">02</span><b>LinkedIn</b><small>marcos-mariñas-cotelo</small><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg></a>
        <a class="hb-row" href={CV} target="_blank" rel="noopener"><span class="mono">03</span><b>{h.cv}</b><small>PDF</small><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg></a>
      </div>
      <span class="hb-mark" aria-hidden="true">MMC</span>
    </section>
    </div>
  </div>

<script>
  const dEl = document.querySelector<HTMLElement>('[data-days]');
  if (dEl) {
    const left = Math.max(0, Math.ceil((new Date(2027, 0, 1).getTime() - Date.now()) / 86400000));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    dEl.textContent = String(left);
    new IntersectionObserver((es, io) => {
      if (!es[0].isIntersecting) return;
      io.disconnect();
      if (left === 0) { dEl.textContent = dEl.dataset.done || ''; return; }
      if (reduce) return;
      const t0 = performance.now();
      const step = (t: number) => { const k = Math.min(1, (t - t0) / 1600); dEl.textContent = String(Math.round(left * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(step); };
      requestAnimationFrame(step);
    }, { threshold: 0.4 }).observe(dEl);
  }
</script>
</Base>
