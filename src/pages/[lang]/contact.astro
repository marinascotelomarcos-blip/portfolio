---
import Base from '../../layouts/Base.astro';
import Scene from '../../components/Scene.astro';
import ContactLinks from '../../components/ContactLinks.astro';
import { T, LANGS, CV, type Lang } from '../../lib/content';
export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const c = T[lang].contact;
const status = lang === 'en' ? 'Available from January 2027' : 'Disponible desde enero de 2027';
const cap = lang === 'en' ? 'Drag the globe · A Coruña, Spain' : 'Arrastra el globo · A Coruña, España';
---
<Base lang={lang} title={c.title} path="/contact/" current="contact">
  <div class="wrap hero">
    <p class="cx-status mono"><i></i>{status}</p>
    <h1 class="display" style="margin-top:18px">{c.title}</h1>
    <p class="lede" style="max-width:34ch">{c.lede}</p>

    <div class="cx">
      <div>
        <ContactLinks lang={lang} big />
        <div class="cx-cv">
          <div><b>{c.cv}</b><small>{c.cvNote}</small></div>
          <a class="btn primary" href={CV} download>Marcos-Marinas-CV-ES.pdf</a>
        </div>
        <p class="muted" style="margin-top:22px">{c.looking}</p>
      </div>
      <div class="cx-globe">
        <Scene kind="globe" />
        <span class="cap mono">{cap}</span>
      </div>
    </div>
  </div>
</Base>
