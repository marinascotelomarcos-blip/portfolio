---
import '../../styles/global.css';
import Backdrop from '../../components/Backdrop.astro';
import { LOGOS } from '../../lib/logos';
import { LANGS, EMAIL, CV, LINKEDIN, type Lang } from '../../lib/content';
export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const en = lang === 'en';
const other: Lang = en ? 'es' : 'en';
const SITE = 'https://marcosmarinascotelo.com';
const cards = [
  { id: 'portfolio', href: `/${lang}/`, main: true, ext: false, name: en ? 'Get to know me' : 'Conóceme', sub: en ? 'Portfolio: projects and about me' : 'Portafolio: proyectos y sobre mí', side: 'l' },
  { id: 'linkedin', href: LINKEDIN, ext: true, name: 'LinkedIn', sub: 'marcos-mariñas-cotelo', side: 'l' },
  { id: 'cv', href: CV, ext: true, name: 'CV', sub: en ? 'PDF, in Spanish' : 'PDF', side: 'r' },
  { id: 'mail', href: `mailto:${EMAIL}`, ext: false, name: en ? 'Write to me' : 'Escríbeme', sub: EMAIL, side: 'r' },
];
const side = (s: string) => cards.map((c, i) => ({ ...c, i })).filter((c) => c.side === s);
---
<!doctype html>
<html lang={en ? 'en' : 'es'} data-mode="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{en ? 'Hi, I’m Marcos — Marcos Mariñas Cotelo' : 'Hola, soy Marcos — Marcos Mariñas Cotelo'}</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0a0f12" />
    <link rel="canonical" href={`${SITE}/${lang}/hola/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try { var sv = localStorage.getItem('mmc-mode'); document.documentElement.dataset.mode = sv === 'light' ? 'light' : 'dark'; } catch (e) {}
    </script>
  </head>
  <body class="gate">
    <Backdrop />
    <header class="gate-top">
      <span class="mono gate-mark"><i></i>MMC · {en ? 'ACCESS' : 'ACCESO'}</span>
      <a class="mono gate-lang" href={`/${other}/hola/`} hreflang={other} lang={other}>{en ? 'ES' : 'EN'}</a>
    </header>

    <main class="gate-main">
      <div class="gate-head">
        <p class="mono gate-status"><i></i>{en ? 'Available from January 2027' : 'Disponible desde enero de 2027'}</p>
        <h1>{en ? 'Hi, I’m Marcos.' : 'Hola, soy Marcos.'}<br /><span>{en ? 'Want to know me?' : '¿Quieres conocerme?'}</span></h1>
      </div>

      <div class="gate-stage">
        <div class="gate-col l">
          {side('l').map((c) => {
            const g = LOGOS[c.id];
            return (
              <a class:list={['gate-card', c.main && 'main']} style={`--i:${c.i};--c:${g.hex}`} href={c.href} {...(c.ext ? { target: '_blank', rel: 'noopener noreferrer' } : {})} data-gate={c.main ? 'enter' : undefined}>
                <span class="gc-ico" aria-hidden="true">
                  {g.kind === 'brand' && <svg viewBox="0 0 24 24" fill="currentColor"><path d={g.path} /></svg>}
                  {g.kind === 'glyph' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">{g.paths.map((d) => <path d={d} />)}</svg>}
                  {g.kind === 'mono' && <svg viewBox="0 0 24 24"><rect x="2.5" y="2.5" width="19" height="19" rx="5" fill="none" stroke="currentColor" stroke-width="1.6" /><text x="12" y="15.6" text-anchor="middle" font-size="10" font-weight="700" fill="currentColor" font-family="system-ui, sans-serif">{g.text}</text></svg>}
                </span>
                <span class="gc-txt"><b>{c.name}</b><small>{c.sub}</small></span>
                <span class="gc-go" aria-hidden="true">{c.ext ? '↗' : '→'}</span>
              </a>
            );
          })}
        </div>

        <div class="gate-fig">
          <span class="gate-halo" aria-hidden="true"></span>
          <span class="gate-ring" aria-hidden="true"><i></i><i></i><i></i></span>

          <svg class="obj o-cards" viewBox="0 0 64 64" aria-hidden="true" style="--d:0"><g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"><rect x="9" y="12" width="28" height="40" rx="4" transform="rotate(-14 23 32)" /><rect x="26" y="12" width="28" height="40" rx="4" transform="rotate(10 40 32)" fill="var(--bg)" /><path d="M40 27c-3-5-9-1-6 4l6 7 6-7c3-5-3-9-6-4z" fill="currentColor" stroke="none" transform="rotate(10 40 32)" /></g></svg>
          <svg class="obj o-globe" viewBox="0 0 64 64" aria-hidden="true" style="--d:1"><g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="32" cy="32" r="22" /><ellipse cx="32" cy="32" rx="9" ry="22" /><path d="M10 32h44M14 21h36M14 43h36" /><path d="M6 14c10-9 24-10 34-6" stroke-dasharray="2 5" /></g></svg>
          <svg class="obj o-surf" viewBox="0 0 64 64" aria-hidden="true" style="--d:2"><g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 6c8 6 10 30 4 52-8-4-14-20-4-52z" transform="rotate(-18 32 32)" /><path d="M24 10l-2 44" transform="rotate(-18 32 32)" /><path d="M42 8l12 46M48 6l12 46" /></g></svg>
          <svg class="obj o-phone" viewBox="0 0 64 64" aria-hidden="true" style="--d:3"><g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="19" y="6" width="26" height="52" rx="6" /><path d="M28 12h8" /><path d="M25 26h14M25 33h14M25 40h9" /><circle cx="32" cy="50" r="1.6" fill="currentColor" /></g></svg>
          <span class="obj spark s1" aria-hidden="true"></span><span class="obj spark s2" aria-hidden="true"></span><span class="obj spark s3" aria-hidden="true"></span>

          <img class="gate-man" src="/img/marcos-character.png" width="380" height="1148" alt={en ? 'Illustration of Marcos: curly hair, amber glasses, cream knit' : 'Ilustración de Marcos: pelo rizado, gafas ámbar, jersey crema'} />
        </div>

        <div class="gate-col r">
          {side('r').map((c) => {
            const g = LOGOS[c.id];
            return (
              <a class="gate-card" style={`--i:${c.i};--c:${g.hex}`} href={c.href} {...(c.ext ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                <span class="gc-ico" aria-hidden="true">
                  {g.kind === 'glyph' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">{g.paths.map((d) => <path d={d} />)}</svg>}
                </span>
                <span class="gc-txt"><b>{c.name}</b><small>{c.sub}</small></span>
                <span class="gc-go" aria-hidden="true">{c.ext ? '↗' : '→'}</span>
              </a>
            );
          })}
        </div>
      </div>
    </main>

    <style is:global>
      body.gate { padding: 0; min-height: 100dvh; overflow-x: hidden; display: flex; flex-direction: column; }
      .gate-top { position: relative; z-index: 5; display: flex; justify-content: space-between; align-items: center; padding: max(18px, env(safe-area-inset-top)) var(--gutter) 0; }
      .gate-mark { display: inline-flex; align-items: center; gap: 10px; font-size: 0.74rem; letter-spacing: 0.14em; color: var(--ink-2); }
      .gate-mark i { width: 7px; height: 7px; background: var(--teal); }
      .gate-lang { font-size: 0.74rem; letter-spacing: 0.1em; padding: 7px 12px; border: 1px solid var(--rule); border-radius: 4px; color: var(--ink); text-decoration: none; background: color-mix(in oklab, var(--bg) 70%, transparent); }
      .gate-lang:hover { background: var(--teal); color: var(--on-teal); border-color: var(--teal); }
      .gate-main { position: relative; z-index: 3; flex: 1; width: 100%; max-width: 1180px; margin: 0 auto; padding: clamp(12px, 3vh, 36px) var(--gutter) max(28px, env(safe-area-inset-bottom)); display: flex; flex-direction: column; justify-content: center; gap: clamp(8px, 2vh, 24px); transition: opacity .45s, transform .45s var(--ease); }
      .gate-head { text-align: center; animation: gate-in .8s var(--ease) .15s backwards; }
      .gate-status { display: inline-flex; align-items: center; gap: 9px; margin: 0 0 14px; padding: 6px 14px; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; border: 1px solid var(--rule); border-radius: 99px; color: var(--ink-2); background: color-mix(in oklab, var(--bg) 70%, transparent); }
      .gate-status i { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); animation: ping 2s infinite; box-shadow: 0 0 0 0 var(--ok); }
      .gate-head h1 { margin: 0; font-size: clamp(2.2rem, 6vw, 4.6rem); line-height: 1.02; letter-spacing: -0.04em; font-weight: 600; }
      .gate-head h1 span { color: var(--teal-ink); }

      .gate-stage { display: grid; grid-template-columns: minmax(0, 1fr) clamp(240px, 30vw, 380px) minmax(0, 1fr); align-items: center; gap: clamp(14px, 3vw, 40px); }
      .gate-col { display: grid; gap: 14px; align-content: center; }
      .gate-col.l .gate-card { --from: 220px; }
      .gate-col.r .gate-card { --from: -220px; }
      .gate-card { position: relative; display: flex; align-items: center; gap: 14px; min-height: 84px; padding: 16px 20px; border: 1px solid var(--rule); border-radius: 14px; background: color-mix(in oklab, var(--bg-2) 82%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); color: var(--ink); text-decoration: none; animation: gate-unfold .9s var(--ease) calc(1.1s + var(--i) * .16s) backwards; transition: transform .3s var(--ease), border-color .25s, background .25s, box-shadow .3s; }
      .gate-card:hover { transform: translateY(-4px) scale(1.02); border-color: var(--c); box-shadow: 0 10px 30px -12px var(--c); }
      .gate-card:active { transform: scale(.98); }
      .gc-ico { flex: none; width: 38px; height: 38px; color: var(--c); display: grid; place-items: center; }
      .gc-ico svg { width: 100%; height: 100%; }
      .gc-txt { display: grid; min-width: 0; line-height: 1.2; }
      .gc-txt b { font-weight: 600; font-size: 1.08rem; }
      .gc-txt small { font-family: var(--mono); font-size: 0.7rem; color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 4px; }
      .gc-go { margin-left: auto; color: var(--teal); font-size: 1.2rem; transition: transform .3s var(--ease); }
      .gate-card:hover .gc-go { transform: translateX(4px); }
      .gate-card.main { min-height: 118px; background: var(--teal); border-color: var(--teal); color: var(--on-teal); box-shadow: 0 0 0 0 color-mix(in oklab, var(--teal) 60%, transparent); animation: gate-unfold .9s var(--ease) 1.1s backwards, gate-call 2.4s ease-out 2.4s infinite; }
      .gate-card.main .gc-ico, .gate-card.main .gc-go, .gate-card.main small { color: var(--on-teal); }
      .gate-card.main small { opacity: .85; white-space: normal; overflow: visible; }
      .gate-card.main .gc-txt b { font-size: 1.5rem; letter-spacing: -0.02em; }
      .gate-card.main:hover { background: var(--teal-ink); border-color: var(--teal-ink); box-shadow: 0 12px 34px -10px var(--teal); }

      .gate-fig { position: relative; height: clamp(360px, 52vh, 500px); display: grid; place-items: end center; }
      .gate-man { position: relative; z-index: 3; width: clamp(104px, 13vw, 156px); height: auto; margin-bottom: 38px; transform-origin: 50% 100%; filter: drop-shadow(0 0 16px rgba(59,184,190,.5)); animation: materialize 1.6s var(--ease) .3s backwards, gate-groove 1.6s ease-in-out 1.9s infinite; }
      .gate-ring { position: absolute; z-index: 1; left: 50%; bottom: 8px; width: 100%; aspect-ratio: 5 / 1.3; transform: translateX(-50%); }
      .gate-ring i { position: absolute; left: 50%; top: 50%; border-radius: 50%; transform: translate(-50%, -50%); border: 2px solid var(--teal); box-shadow: 0 0 22px 2px color-mix(in oklab, var(--teal) 70%, transparent), inset 0 0 20px color-mix(in oklab, var(--teal) 40%, transparent); }
      .gate-ring i:nth-child(1) { width: 100%; height: 100%; animation: baseIn 1s var(--ease) .1s backwards, ringPulse 1.6s ease-in-out 1.2s infinite; }
      .gate-ring i:nth-child(2) { width: 72%; height: 72%; opacity: .7; border-width: 1px; animation: baseIn 1.2s var(--ease) .2s backwards; }
      .gate-ring i:nth-child(3) { width: 46%; height: 46%; border: 0; box-shadow: none; background: radial-gradient(closest-side, color-mix(in oklab, var(--teal) 55%, transparent), transparent); animation: baseIn 1.3s var(--ease) .3s backwards; }
      .gate-halo { position: absolute; z-index: 0; left: 50%; top: 50%; width: 120%; aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; background: radial-gradient(closest-side, color-mix(in oklab, var(--teal) 24%, transparent), transparent); animation: gate-in 1.4s ease .2s backwards; }

      .obj { position: absolute; z-index: 4; width: clamp(48px, 5.4vw, 70px); height: auto; color: var(--teal-ink); filter: drop-shadow(0 0 10px color-mix(in oklab, var(--teal) 55%, transparent)); animation: gate-pop .7s var(--ease) calc(.9s + var(--d) * .14s) backwards, gate-dance 1.6s ease-in-out calc(1.6s + var(--d) * .22s) infinite alternate; }
      .o-cards { left: 2%; top: 12%; --r: -10deg; }
      .o-globe { right: 0; top: 4%; --r: 8deg; }
      .o-surf { left: -2%; bottom: 26%; --r: 12deg; }
      .o-phone { right: 2%; bottom: 22%; --r: -8deg; }
      .spark { width: 5px; height: 5px; border-radius: 50%; background: var(--teal-ink); box-shadow: 0 0 10px var(--teal); }
      .s1 { left: 30%; top: 4%; --d: 1; --r: 0deg; } .s2 { right: 24%; top: 30%; --d: 3; --r: 0deg; } .s3 { left: 20%; bottom: 40%; --d: 2; --r: 0deg; }

      @keyframes gate-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
      @keyframes gate-unfold { 0% { opacity: 0; transform: translateX(var(--from)) scale(.2) rotate(calc(var(--from) / 14)); } 100% { opacity: 1; transform: none; } }
      @keyframes gate-pop { from { opacity: 0; transform: scale(0) rotate(-40deg); } to { opacity: 1; transform: scale(1) rotate(0); } }
      @keyframes gate-dance { from { transform: translateY(0) rotate(var(--r, 6deg)); } to { transform: translateY(-14px) rotate(calc(var(--r, 6deg) * -1)); } }
      @keyframes gate-groove { 0%, 100% { transform: rotate(-2.4deg) scaleY(1); } 25% { transform: rotate(0) scaleY(.975) translateY(2px); } 50% { transform: rotate(2.4deg) scaleY(1) translateY(-6px); } 75% { transform: rotate(0) scaleY(.975) translateY(2px); } }
      @keyframes gate-call { 0% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--teal) 60%, transparent); } 70%, 100% { box-shadow: 0 0 0 18px transparent; } }

      body.leaving .gate-main { opacity: 0; transform: scale(1.06); }

      @media (max-width: 860px) {
        .gate-main { justify-content: flex-start; padding-top: 6px; }
        .gate-stage { grid-template-columns: 1fr 1fr; gap: 12px; }
        .gate-fig { grid-column: 1 / -1; grid-row: 1; height: 330px; margin-bottom: 8px; }
        .gate-col.r .gate-card:last-child { grid-column: 1 / -1; }
        .gate-col { display: contents; }
        .gate-card, .gate-col.l .gate-card, .gate-col.r .gate-card { --from: 0px; min-height: 72px; padding: 12px 14px; gap: 10px; animation-name: gate-unfold; }
        .gate-card.main { grid-column: 1 / -1; grid-row: 2; min-height: 96px; }
        .gate-card.main .gc-txt b { font-size: 1.3rem; }
        .gc-ico { width: 30px; height: 30px; }
        .gc-txt b { font-size: 1rem; }
        .gc-go { display: none; }
        .gate-man { width: 92px; margin-bottom: 30px; }
        .obj { width: 46px; }
        .o-cards { left: 8%; } .o-globe { right: 6%; } .o-surf { left: 6%; } .o-phone { right: 8%; }
      }
      @media (prefers-reduced-motion: reduce) {
        .gate-main *, .obj, .gate-man, .gate-ring i, .gate-halo { animation: none !important; transition: none !important; }
      }
    </style>
    <script is:inline>
      (function () {
        var a = document.querySelector('[data-gate="enter"]'); if (!a) return;
        a.addEventListener('click', function (e) {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button) return;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          e.preventDefault(); document.body.classList.add('leaving');
          setTimeout(function () { location.href = a.href; }, 380);
        });
      })();
    </script>
  </body>
</html>
