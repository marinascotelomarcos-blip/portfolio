---
import '../../styles/global.css';
import Backdrop from '../../components/Backdrop.astro';
import { LANGS, VISITED, EMAIL, CV, LINKEDIN, type Lang } from '../../lib/content';
export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const en = lang === 'en';
const other: Lang = en ? 'es' : 'en';
const SITE = 'https://marcosmarinascotelo.com';
const cards = [
  { n: '01', href: `/${lang}/`, main: true, ext: false, k: en ? 'Portfolio' : 'Portafolio', name: en ? 'Get to know me' : 'Conóceme', sub: en ? 'Projects, the world tour and who I am' : 'Proyectos, la ruta y quién soy' },
  { n: '02', href: LINKEDIN, ext: true, k: en ? 'Network' : 'Red profesional', name: 'LinkedIn', sub: 'marcos-mariñas-cotelo' },
  { n: '03', href: CV, ext: true, k: 'PDF', name: en ? 'My CV' : 'Mi CV', sub: en ? 'In Spanish' : 'En español' },
  { n: '04', href: `mailto:${EMAIL}`, ext: false, k: en ? 'Email' : 'Correo', name: en ? 'Write to me' : 'Escríbeme', sub: EMAIL },
].map((c, i) => ({ ...c, i }));
const objs = [
  { kind: 'cards', cls: 'o-cards', d: 0 },
  { kind: 'globe', cls: 'o-globe', d: 1 },
  { kind: 'outside', cls: 'o-surf', d: 2 },
  { kind: 'phone', cls: 'o-phone', d: 3 },
];
---
<!doctype html>
<html lang={en ? 'en' : 'es'} data-mode="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{en ? 'Hi, I’m Marcos — Marcos Mariñas Cotelo' : 'Hola, soy Marcos — Marcos Mariñas Cotelo'}</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0a0f12" />
    <link rel="canonical" href={`${SITE}/${lang}/hola/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try { var sv = localStorage.getItem('mmc-mode'); document.documentElement.dataset.mode = sv === 'light' ? 'light' : 'dark'; } catch (e) {}
    </script>
  </head>
  <body class="gate">
    <Backdrop />
    <header class="gate-top">
      <span class="mono gate-mark"><i></i>MMC · {en ? 'ACCESS' : 'ACCESO'}</span>
      <a class="mono gate-lang" href={`/${other}/hola/`} hreflang={other} lang={other}>{en ? 'ES' : 'EN'}</a>
    </header>

    <main class="gate-main">
      <div class="gate-head">
        <p class="mono gate-status"><i></i>{en ? 'Available from January 2027' : 'Disponible desde enero de 2027'}</p>
        <h1>{en ? 'Hi, I’m Marcos.' : 'Hola, soy Marcos.'}<br /><span>{en ? 'Want to know me?' : '¿Quieres conocerme?'}</span></h1>
      </div>

      <div class="gate-stage">
        <div class="gate-col l">
          {cards.slice(0, 2).map((c) => (
            <a class:list={['gc', c.main && 'main']} style={`--i:${c.i}`} href={c.href} {...(c.ext ? { target: '_blank', rel: 'noopener noreferrer' } : {})} data-gate={c.main ? 'enter' : undefined}>
              <span class="gc-top mono"><b>{c.n}</b><i>{c.k}</i></span>
              <span class="gc-t">{c.name}</span>
              <span class="gc-s">{c.sub}</span>
              <span class="gc-a" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8" /></svg></span>
            </a>
          ))}
        </div>

        <div class="gate-fig">
          <span class="gate-halo" aria-hidden="true"></span>
          <span class="gate-ring" aria-hidden="true"><i></i><i></i></span>
          {objs.map((o) => (
            <div class:list={['obj', o.cls]} style={`--d:${o.d}`}>
              <div class="scene" data-scene={o.kind} data-visited={o.kind === 'globe' ? JSON.stringify(VISITED) : undefined} aria-hidden="true"><canvas></canvas></div>
            </div>
          ))}
          <img class="gate-man" src="/img/marcos-character.png" width="380" height="1148" alt={en ? 'Illustration of Marcos: curly hair, amber glasses, cream knit' : 'Ilustración de Marcos: pelo rizado, gafas ámbar, jersey crema'} />
        </div>

        <div class="gate-col r">
          {cards.slice(2).map((c) => (
            <a class="gc" style={`--i:${c.i}`} href={c.href} {...(c.ext ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              <span class="gc-top mono"><b>{c.n}</b><i>{c.k}</i></span>
              <span class="gc-t">{c.name}</span>
              <span class="gc-s">{c.sub}</span>
              <span class="gc-a" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8" /></svg></span>
            </a>
          ))}
        </div>
      </div>
    </main>

    <style is:global>
      body.gate { padding: 0; min-height: 100dvh; overflow-x: hidden; display: flex; flex-direction: column; }
      .gate-top { position: relative; z-index: 5; display: flex; justify-content: space-between; align-items: center; padding: max(18px, env(safe-area-inset-top)) var(--gutter) 0; }
      .gate-mark { display: inline-flex; align-items: center; gap: 10px; font-size: 0.74rem; letter-spacing: 0.14em; color: var(--ink-2); }
      .gate-mark i { width: 7px; height: 7px; background: var(--teal); }
      .gate-lang { font-size: 0.74rem; letter-spacing: 0.1em; padding: 7px 12px; border: 1px solid var(--rule); border-radius: 4px; color: var(--ink); text-decoration: none; background: color-mix(in oklab, var(--bg) 70%, transparent); }
      .gate-lang:hover { background: var(--teal); color: var(--on-teal); border-color: var(--teal); }
      .gate-main { position: relative; z-index: 3; flex: 1; width: 100%; max-width: 1240px; margin: 0 auto; padding: clamp(8px, 2vh, 28px) var(--gutter) max(28px, env(safe-area-inset-bottom)); display: flex; flex-direction: column; justify-content: center; gap: clamp(4px, 1.5vh, 18px); transition: opacity .45s, transform .45s var(--ease); }
      .gate-head { text-align: center; animation: gate-in .8s var(--ease) .15s backwards; }
      .gate-status { display: inline-flex; align-items: center; gap: 9px; margin: 0 0 14px; padding: 6px 14px; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; border: 1px solid var(--rule); border-radius: 99px; color: var(--ink-2); background: color-mix(in oklab, var(--bg) 70%, transparent); }
      .gate-status i { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); animation: ping 2s infinite; box-shadow: 0 0 0 0 var(--ok); }
      .gate-head h1 { margin: 0; font-size: clamp(2.2rem, 5.6vw, 4.4rem); line-height: 1.02; letter-spacing: -0.04em; font-weight: 600; }
      .gate-head h1 span { color: var(--teal-ink); }

      .gate-stage { display: grid; grid-template-columns: minmax(0, 1fr) clamp(300px, 36vw, 470px) minmax(0, 1fr); align-items: center; gap: clamp(10px, 2vw, 28px); }
      .gate-col { display: grid; gap: 14px; align-content: center; }
      .gate-col.l .gc { --from: 160px; }
      .gate-col.r .gc { --from: -160px; }

      /* Choice cards: editorial panels, hairline frame, mono index, big title, arrow disc */
      .gc { position: relative; isolation: isolate; overflow: hidden; display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'top top' 't a' 's a'; align-items: end; row-gap: 4px; column-gap: 12px; min-height: 126px; padding: 16px 18px 18px; border-radius: 6px; color: var(--ink); text-decoration: none; background: linear-gradient(160deg, color-mix(in oklab, var(--bg-2) 88%, transparent), color-mix(in oklab, var(--bg) 60%, transparent)); border: 1px solid var(--rule); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); animation: gate-unfold 1s var(--ease) calc(1.1s + var(--i) * .15s) backwards; transition: transform .35s var(--ease), border-color .3s, box-shadow .35s; }
      .gc::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(100deg, color-mix(in oklab, var(--teal) 22%, transparent), transparent 70%); transform: translateX(-101%); transition: transform .55s var(--ease); }
      .gc::after { content: ''; position: absolute; left: 0; top: 0; width: 18px; height: 18px; border-left: 2px solid var(--teal); border-top: 2px solid var(--teal); border-top-left-radius: 6px; opacity: .7; }
      .gc:hover { transform: translateY(-3px); border-color: var(--teal); box-shadow: 0 18px 40px -22px var(--teal); }
      .gc:hover::before { transform: none; }
      .gc:active { transform: scale(.985); }
      .gc-top { grid-area: top; display: flex; justify-content: space-between; align-items: baseline; font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); margin-bottom: 16px; }
      .gc-top b { font-weight: 500; color: var(--teal-ink); }
      .gc-top i { font-style: normal; }
      .gc-t { grid-area: t; font-size: clamp(1.25rem, 1.9vw, 1.6rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.05; }
      .gc-s { grid-area: s; font-family: var(--mono); font-size: .7rem; color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .gc-a { grid-area: a; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--rule); color: var(--teal-ink); transition: background .3s, color .3s, border-color .3s, transform .45s var(--ease); }
      .gc-a svg { width: 18px; height: 18px; }
      .gc:hover .gc-a { background: var(--teal); color: var(--on-teal); border-color: var(--teal); transform: rotate(45deg); }

      .gc.main { min-height: 176px; border-color: var(--teal); background: linear-gradient(150deg, var(--teal), color-mix(in oklab, var(--teal) 82%, #000)); color: var(--on-teal); animation: gate-unfold 1s var(--ease) 1.1s backwards; }
      .gc.main::before { background: linear-gradient(100deg, transparent 20%, rgba(255,255,255,.28) 50%, transparent 80%); transform: translateX(-101%); animation: gate-shine 3.6s ease-in-out 2.6s infinite; transition: none; }
      .gc.main::after { border-color: var(--on-teal); opacity: .9; }
      .gc.main .gc-top, .gc.main .gc-top b, .gc.main .gc-s { color: var(--on-teal); opacity: .86; }
      .gc.main .gc-t { font-size: clamp(1.7rem, 2.8vw, 2.4rem); }
      .gc.main .gc-a { border-color: color-mix(in oklab, var(--on-teal) 55%, transparent); color: var(--on-teal); width: 46px; height: 46px; }
      .gc.main:hover { box-shadow: 0 22px 50px -20px var(--teal); }
      .gc.main:hover .gc-a { background: var(--on-teal); color: var(--teal); border-color: var(--on-teal); }

      /* Stage: the 3D objects lead, Marcos stands small among them */
      .gate-fig { position: relative; height: clamp(380px, 56vh, 520px); }
      .gate-halo { position: absolute; z-index: 0; left: 50%; top: 52%; width: 110%; aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; background: radial-gradient(closest-side, color-mix(in oklab, var(--teal) 18%, transparent), transparent); animation: gate-in 1.4s ease .2s backwards; }
      .gate-ring { position: absolute; z-index: 1; left: 50%; bottom: 3%; width: 54%; aspect-ratio: 5 / 1.3; transform: translateX(-50%); }
      .gate-ring i { position: absolute; left: 50%; top: 50%; border-radius: 50%; transform: translate(-50%, -50%); border: 1px solid color-mix(in oklab, var(--teal) 70%, transparent); box-shadow: 0 0 16px color-mix(in oklab, var(--teal) 40%, transparent); }
      .gate-ring i:nth-child(1) { width: 100%; height: 100%; animation: baseIn 1s var(--ease) .1s backwards; }
      .gate-ring i:nth-child(2) { width: 62%; height: 62%; opacity: .6; animation: baseIn 1.2s var(--ease) .2s backwards; }
      .gate-man { position: absolute; z-index: 3; left: 50%; bottom: 7%; width: clamp(70px, 7.4vw, 96px); height: auto; transform: translateX(-50%); filter: drop-shadow(0 0 8px rgba(59,184,190,.28)); animation: materialize 1.6s var(--ease) .3s backwards, gate-idle 7s ease-in-out 2s infinite; }
      .obj { position: absolute; z-index: 2; width: clamp(130px, 14vw, 190px); animation: gate-pop .9s var(--ease) calc(.8s + var(--d) * .15s) backwards, gate-float calc(6s + var(--d) * 1.1s) ease-in-out calc(1.8s + var(--d) * .4s) infinite; }
      .obj .scene { height: clamp(130px, 14vw, 190px); }
      .o-cards { left: -2%; top: 2%; }
      .o-globe { right: -4%; top: -2%; width: clamp(150px, 16vw, 215px); }
      .o-globe .scene { height: clamp(150px, 16vw, 215px); }
      .o-surf { left: -4%; bottom: 8%; }
      .o-phone { right: 0; bottom: 6%; }

      @keyframes gate-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
      @keyframes gate-unfold { 0% { opacity: 0; transform: translateX(var(--from)) scale(.6); } 100% { opacity: 1; transform: none; } }
      /* no scale here: the 3D canvases size themselves from their on-screen box, so scaling would render them blurry */
      @keyframes gate-pop { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
      @keyframes gate-float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -10px; } }
      @keyframes gate-idle { 0%, 100% { translate: 0 0; } 50% { translate: 0 -3px; } }
      @keyframes gate-shine { 0% { transform: translateX(-101%); } 45%, 100% { transform: translateX(101%); } }

      body.leaving .gate-main { opacity: 0; transform: scale(1.05); }

      @media (max-width: 860px) {
        .gate-main { justify-content: flex-start; padding-top: 6px; }
        .gate-stage { grid-template-columns: 1fr 1fr; gap: 12px; }
        .gate-fig { grid-column: 1 / -1; grid-row: 1; height: 330px; }
        .gate-col { display: contents; }
        .gc, .gate-col.l .gc, .gate-col.r .gc { --from: 0px; min-height: 104px; padding: 12px 14px 14px; }
        .gc-top { margin-bottom: 10px; }
        .gc.main { grid-column: 1 / -1; grid-row: 2; min-height: 132px; }
        .gate-col.r .gc:last-child { grid-column: 1 / -1; }
        .gc-a { width: 32px; height: 32px; }
        .gate-man { width: 66px; bottom: 6%; }
        .obj, .o-globe { width: 118px; }
        .obj .scene, .o-globe .scene { height: 118px; }
        .o-cards { left: 0; top: 0; } .o-globe { right: 0; top: 0; } .o-surf { left: 0; bottom: 6%; } .o-phone { right: 0; bottom: 4%; }
      }
      @media (prefers-reduced-motion: reduce) {
        .gate-main *, .obj, .gate-man, .gate-ring i, .gate-halo { animation: none !important; transition: none !important; }
      }
    </style>
    <script is:inline>
      (function () {
        var a = document.querySelector('[data-gate="enter"]'); if (!a) return;
        a.addEventListener('click', function (e) {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button) return;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          e.preventDefault(); document.body.classList.add('leaving');
          setTimeout(function () { location.href = a.href; }, 380);
        });
      })();
    </script>
    <script>
      const els = document.querySelectorAll<HTMLElement>('[data-scene]');
      els.forEach((el) => {
        import('../../lib/scenes.js')
          .then(({ mount }) => mount(el, el.dataset.scene as string, { visited: JSON.parse(el.dataset.visited || '[]'), mapUrl: '/world.svg', portrait: '' }))
          .catch(() => { el.hidden = true; });
      });
    </script>
  </body>
</html>
