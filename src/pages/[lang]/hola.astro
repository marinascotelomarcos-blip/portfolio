---
import '../../styles/global.css';
import Backdrop from '../../components/Backdrop.astro';
import { LANGS, EMAIL, CV, LINKEDIN, type Lang } from '../../lib/content';
export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const en = lang === 'en';
const other: Lang = en ? 'es' : 'en';
const SITE = 'https://marcosmarinascotelo.com';
const rows = [
  { n: '01', href: `/${lang}/`, main: true, ext: false, k: en ? 'Portfolio' : 'Portafolio', name: en ? 'Get to know me' : 'Conóceme', sub: en ? 'Projects, the world tour and who I am' : 'Proyectos, la ruta y quién soy' },
  { n: '02', href: LINKEDIN, ext: true, k: en ? 'Network' : 'Red profesional', name: 'LinkedIn', sub: 'marcos-mariñas-cotelo' },
  { n: '03', href: CV, ext: true, k: 'PDF', name: en ? 'My CV' : 'Mi CV', sub: en ? 'In Spanish' : 'En español' },
  { n: '04', href: `mailto:${EMAIL}`, ext: false, k: en ? 'Email' : 'Correo', name: en ? 'Write to me' : 'Escríbeme', sub: EMAIL },
].map((c, i) => ({ ...c, i }));
const bubble = en ? 'Want me to show you around?' : '¿Te enseño lo que hago?';
---
<!doctype html>
<html lang={en ? 'en' : 'es'} data-mode="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{en ? 'Hi, I’m Marcos — Marcos Mariñas Cotelo' : 'Hola, soy Marcos — Marcos Mariñas Cotelo'}</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0a0f12" />
    <link rel="canonical" href={`${SITE}/${lang}/hola/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try { var sv = localStorage.getItem('mmc-mode'); document.documentElement.dataset.mode = sv === 'light' ? 'light' : 'dark'; } catch (e) {}
    </script>
  </head>
  <body class="gate">
    <Backdrop />
    <header class="gate-top">
      <span class="mono gate-mark"><i></i>MMC · {en ? 'ACCESS' : 'ACCESO'}</span>
      <a class="mono gate-lang" href={`/${other}/hola/`} hreflang={other} lang={other}>{en ? 'ES' : 'EN'}</a>
    </header>

    <main class="gate-main">
      <div class="gate-head">
        <p class="mono gate-status"><i></i>{en ? 'Available from January 2027' : 'Disponible desde enero de 2027'}</p>
        <h1>{en ? 'Hi, I’m Marcos.' : 'Hola, soy Marcos.'}</h1>
      </div>

      <nav class="gate-list" aria-label={en ? 'Where to next' : 'Por dónde seguir'}>
        {rows.map((r) => {
          const link = (
            <a class:list={['row', r.main && 'main']} style={`--i:${r.i}`} href={r.href} {...(r.ext ? { target: '_blank', rel: 'noopener noreferrer' } : {})} data-gate={r.main ? 'enter' : undefined}>
              <span class="r-n mono">{r.n}</span>
              <span class="r-txt"><i class="mono">{r.k}</i><b>{r.name}</b></span>
              <span class="r-sub">{r.sub}</span>
              <span class="r-a" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8" /></svg></span>
            </a>
          );
          return r.main ? (
            <div class="main-wrap">
              <p class="bubble" aria-hidden="true">{bubble}</p>
              <div class="peek">
                <img src="/img/marcos-character.webp" width="380" height="1148" alt={en ? 'Illustration of Marcos peeking out from behind the first row' : 'Ilustración de Marcos asomándose por detrás de la primera fila'} />
              </div>
              {link}
            </div>
          ) : link;
        })}
      </nav>
    </main>

    <style is:global>
      body.gate { padding: 0; min-height: 100dvh; overflow-x: hidden; display: flex; flex-direction: column; }
      .gate-top { position: relative; z-index: 5; display: flex; justify-content: space-between; align-items: center; padding: max(18px, env(safe-area-inset-top)) var(--gutter) 0; }
      .gate-mark { display: inline-flex; align-items: center; gap: 10px; font-size: 0.74rem; letter-spacing: 0.14em; color: var(--ink-2); }
      .gate-mark i { width: 7px; height: 7px; background: var(--teal); }
      .gate-lang { font-size: 0.74rem; letter-spacing: 0.1em; padding: 7px 12px; border: 1px solid var(--rule); border-radius: 4px; color: var(--ink); text-decoration: none; background: color-mix(in oklab, var(--bg) 70%, transparent); }
      .gate-lang:hover { background: var(--teal); color: var(--on-teal); border-color: var(--teal); }
      .gate-main { position: relative; z-index: 3; flex: 1; width: 100%; max-width: 760px; margin: 0 auto; padding: clamp(8px, 2vh, 24px) var(--gutter) max(28px, env(safe-area-inset-bottom)); display: flex; flex-direction: column; justify-content: center; gap: clamp(6px, 1.4vh, 14px); transition: opacity .45s, transform .45s var(--ease); }
      .gate-head { text-align: center; animation: gate-in .8s var(--ease) .1s backwards; }
      .gate-status { display: inline-flex; align-items: center; gap: 9px; margin: 0 0 12px; padding: 6px 14px; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; border: 1px solid var(--rule); border-radius: 99px; color: var(--ink-2); background: color-mix(in oklab, var(--bg) 70%, transparent); }
      .gate-status i { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); animation: ping 2s infinite; box-shadow: 0 0 0 0 var(--ok); }
      .gate-head h1 { margin: 0; font-size: clamp(2.2rem, 6vw, 3.8rem); line-height: 1.02; letter-spacing: -0.04em; font-weight: 600; }

      /* The four rows. Row 1 is the invitation; Marcos rises from behind it. */
      .gate-list { display: grid; gap: 10px; margin-top: 215px; }
      .main-wrap { position: relative; }
      .row { position: relative; z-index: 2; isolation: isolate; overflow: hidden; display: grid; grid-template-columns: 34px minmax(0, 1fr) auto 40px; align-items: center; column-gap: 16px; min-height: 68px; padding: 10px 18px; border-radius: 8px; border: 1px solid var(--rule); color: var(--ink); text-decoration: none; background: color-mix(in oklab, var(--bg-2) 92%, transparent); animation: gate-row .9s var(--ease) calc(.25s + var(--i) * .12s) backwards; transition: transform .35s var(--ease), border-color .3s, box-shadow .35s; }
      .row::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(100deg, color-mix(in oklab, var(--teal) 24%, transparent), transparent 75%); transform: translateX(-101%); transition: transform .55s var(--ease); }
      .row:hover { transform: translateX(4px); border-color: var(--teal); }
      .row:hover::before { transform: none; }
      .row:active { transform: scale(.99); }
      .r-n { font-size: .72rem; color: var(--teal-ink); letter-spacing: .08em; }
      .r-txt { display: grid; gap: 2px; min-width: 0; line-height: 1.1; }
      .r-txt i { font-style: normal; font-size: .64rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }
      .r-txt b { font-weight: 600; font-size: clamp(1.1rem, 2.4vw, 1.4rem); letter-spacing: -0.025em; }
      .r-sub { font-family: var(--mono); font-size: .72rem; color: var(--ink-2); text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 26ch; }
      .r-a { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--rule); color: var(--teal-ink); transition: background .3s, color .3s, border-color .3s, transform .45s var(--ease); }
      .r-a svg { width: 18px; height: 18px; }
      .row:hover .r-a { background: var(--teal); color: var(--on-teal); border-color: var(--teal); transform: rotate(45deg); }

      .row.main { min-height: 112px; padding: 16px 22px; border-color: var(--teal); background: linear-gradient(150deg, var(--teal), color-mix(in oklab, var(--teal) 80%, #000)); color: var(--on-teal); box-shadow: 0 18px 50px -24px var(--teal); }
      .row.main::before { background: linear-gradient(100deg, transparent 20%, rgba(255,255,255,.3) 50%, transparent 80%); transform: translateX(-101%); animation: gate-shine 3.8s ease-in-out 2.8s infinite; transition: none; }
      .row.main .r-sub { max-width: 40ch; }
      .row.main .r-n, .row.main .r-txt i, .row.main .r-sub { color: var(--on-teal); opacity: .85; }
      .row.main .r-txt b { font-size: clamp(1.7rem, 4.2vw, 2.5rem); letter-spacing: -0.035em; }
      .row.main .r-a { width: 48px; height: 48px; border-color: color-mix(in oklab, var(--on-teal) 55%, transparent); color: var(--on-teal); }
      .row.main:hover { transform: translateY(-2px); box-shadow: 0 22px 56px -22px var(--teal); }
      .row.main:hover .r-a { background: var(--on-teal); color: var(--teal); border-color: var(--on-teal); }

      /* Marcos: comes up from behind row 1 (the row is opaque, so no clipping is needed), then hops now and then */
      .main-wrap { --px: clamp(40px, 10%, 90px); }
      .peek { position: absolute; z-index: 1; right: var(--px); bottom: calc(100% - 10px); width: 150px; height: 205px; pointer-events: none; clip-path: inset(-40px -30px 0 -30px); }
      .peek img { position: absolute; left: 0; top: 0; display: block; width: 150px; height: auto; filter: drop-shadow(0 6px 14px rgba(0,0,0,.35)); transform-origin: 50% 100%; animation: gate-rise 1.1s cubic-bezier(.2,1.2,.4,1) 1.1s backwards; }
      .bubble { position: absolute; z-index: 3; right: calc(var(--px) + 138px); bottom: calc(100% + 118px); margin: 0; width: max-content; max-width: 190px; padding: 10px 14px; border-radius: 14px 14px 4px 14px; background: var(--ink); color: var(--bg); font-weight: 560; font-size: .95rem; line-height: 1.15; letter-spacing: -0.01em; transform-origin: 100% 100%; animation: gate-bubble .6s cubic-bezier(.2,1.4,.4,1) 2.1s backwards; }

      @keyframes gate-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
      @keyframes gate-row { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
      @keyframes gate-rise { from { transform: translateY(210px); } to { transform: none; } }
      @keyframes gate-hop { 0%, 14%, 100% { transform: translateY(0); } 5% { transform: translateY(5px); } 9% { transform: translateY(-16px); } }
      @keyframes gate-bubble { from { opacity: 0; transform: scale(.2); } to { opacity: 1; transform: none; } }
      @keyframes gate-shine { 0% { transform: translateX(-101%); } 45%, 100% { transform: translateX(101%); } }
      @keyframes gate-nudge { 0%, 70%, 100% { translate: 0 0; } 78% { translate: 4px -4px; } 86% { translate: 0 0; } }

      body.leaving .gate-main { opacity: 0; transform: scale(1.04); }

      @media (max-width: 640px) {
        .gate-main { justify-content: flex-start; padding-top: 10px; }
        .gate-list { margin-top: 200px; gap: 8px; }
        .row { grid-template-columns: 26px minmax(0, 1fr) 36px; column-gap: 12px; min-height: 64px; padding: 10px 14px; }
        .r-sub { display: none; }
        .row.main { min-height: 104px; }
        .row.main .r-a { width: 44px; height: 44px; }
        .main-wrap { --px: 22px; }
        .peek, .peek img { width: 128px; }
        .peek { height: 175px; }
        .bubble { max-width: 140px; font-size: .84rem; padding: 8px 12px; right: calc(var(--px) + 116px); bottom: calc(100% + 100px); }
      }
      @media (prefers-reduced-motion: reduce) {
        .gate-main *, .peek img, .bubble { animation: none !important; transition: none !important; }
      }
    </style>
    <script is:inline>
      (function () {
        var a = document.querySelector('[data-gate="enter"]'); if (!a) return;
        a.addEventListener('click', function (e) {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button) return;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          e.preventDefault(); document.body.classList.add('leaving');
          setTimeout(function () { location.href = a.href; }, 380);
        });
      })();
    </script>
  </body>
</html>
