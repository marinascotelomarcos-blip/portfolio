---
import '../styles/global.css';
import Backdrop from '../components/Backdrop.astro';
import Ticker from '../components/Ticker.astro';
import { T, type Lang } from '../lib/content';

interface Props { lang: Lang; title?: string; description?: string; path?: string; current?: 'home' | 'about' | 'contact' | 'projects' }
const { lang, title, description, path = '/', current } = Astro.props;
const t = T[lang];
const other: Lang = lang === 'en' ? 'es' : 'en';
const pageTitle = title ? `${title} — Marcos Mariñas Cotelo` : t.meta.title;
const desc = description ?? t.meta.description;
const base = `/${lang}`;
---
<!doctype html>
<html lang={t.htmlLang} data-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <link rel="alternate" hreflang={other} href={`/${other}${path}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0f12" />
    <script is:inline>
      var m = 'dark'; try { var sv = localStorage.getItem('mmc-mode'); if (sv === 'dark' || sv === 'light') m = sv; } catch (e) {} document.documentElement.dataset.mode = m;
    </script>
  </head>
  <body>
    <Backdrop />
    <a class="skip" href="#main">{lang === 'en' ? 'Skip to content' : 'Saltar al contenido'}</a>
    <header class="wrap top">
      <a class="brand" href={`${base}/`} title="Marcos Mariñas Cotelo" aria-label={lang === 'en' ? 'Marcos Mariñas Cotelo — home' : 'Marcos Mariñas Cotelo — inicio'}>MMC</a>
      <nav aria-label={lang === 'en' ? 'Main' : 'Principal'}>
        <a href={`${base}/#projects`} aria-current={current === 'projects' ? 'page' : undefined}>{t.nav.projects}</a>
        <a href={`${base}/about/`} aria-current={current === 'about' ? 'page' : undefined}>{t.nav.about}</a>
        <a href={`${base}/contact/`} aria-current={current === 'contact' ? 'page' : undefined}>{t.nav.contact}</a>
      </nav>
    </header>

    <Ticker lang={lang} />
    <main id="main"><slot /></main>

    <div class="statusbar">
      <div class="wrap">
        <div class="left">
          <span class="sb-status mono sb-clock" id="sb-clock" aria-label={lang === 'en' ? 'Local time in A Coruña' : 'Hora local en A Coruña'}>A Coruña</span>
        </div>
        <div class="right">
          <button class="sb" type="button" id="mode-toggle" aria-pressed="false">
            {t.bar.mode}: <span class="on" id="mode-label">{t.bar.reading}</span>
          </button>
          <a class="sb" href={`/${other}${path}`} hreflang={other} lang={other}>{t.bar.lang}</a>
        </div>
      </div>
    </div>


    <div class="rt" id="rt" aria-hidden="true"></div><div class="rt-xy" id="rt-xy" aria-hidden="true"></div>
    <script is:inline define:vars={{ lang }}>
      (function () {
        /* Live clock: A Coruña time, digits roll when they change, and a countdown to January 2027 */
        var el = document.getElementById('sb-clock'); if (!el) return;
        var fmt = new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'es-ES', { timeZone: 'Europe/Madrid', weekday: 'short', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
        var prev = '';
        function build(str) { el.textContent = ''; var chars = Array.from(str); chars.forEach(function (ch) { var sp = document.createElement('span'); sp.className = /\d/.test(ch) ? 'd' : ''; sp.textContent = ch; el.appendChild(sp); }); }
        function days() { var n = new Date(); var t = new Date('2027-01-01T00:00:00+01:00'); return Math.max(0, Math.ceil((t - n) / 864e5)); }
        function tick() {
          var parts = fmt.formatToParts(new Date()).reduce(function (a, p) { a[p.type] = p.value; return a; }, {});
          var clock = parts.hour + ':' + parts.minute + ':' + parts.second;
          var head = ('A Coruña · ' + parts.weekday + ' ' + parts.day + ' ' + parts.month).toUpperCase() + ' · ';
          var tail = '  ·  2027 ' + (lang === 'en' ? 'in ' : 'en ') + days() + (lang === 'en' ? 'd' : ' d');
          var full = head + clock + tail;
          if (!prev || prev.length !== full.length) { build(full); prev = full; return; }
          var kids = el.children;
          for (var i = 0; i < full.length; i++) { if (full[i] !== prev[i]) { kids[i].textContent = full[i]; if (kids[i].className.indexOf('d') > -1) { kids[i].classList.remove('tick'); void kids[i].offsetWidth; kids[i].classList.add('tick'); } } }
          prev = full;
        }
        tick(); setInterval(tick, 1000);
      })();
      (function () {
        /* Reticle cursor with live coordinates, only for fine pointers and when motion is welcome */
        if (!window.matchMedia('(pointer: fine)').matches || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var rt = document.getElementById('rt'), xy = document.getElementById('rt-xy'); if (!rt || !xy) return;
        var x = innerWidth / 2, y = innerHeight / 2, rx = x, ry = y, shown = false; var tgt = null;
        /* Hover state is re-read every frame: the 3D scenes set their pointer cursor one frame after the move. */
        function hot() { var t = tgt; if (!t || !t.closest) return false; var sc = t.closest('[data-scene]'); return !!(t.closest('a, button, [data-station], [data-tile], .holo, .node, .chip, summary, label') || (sc && sc.style.cursor === 'pointer')); }
        addEventListener('pointermove', function (e) { x = e.clientX; y = e.clientY; if (!shown) { shown = true; rx = x; ry = y; rt.classList.add('on'); xy.classList.add('on'); document.documentElement.classList.add('rt-active'); } xy.textContent = 'x:' + String(Math.round(x)).padStart(4, '0') + ' y:' + String(Math.round(y)).padStart(4, '0'); tgt = e.target; }, { passive: true });
        document.addEventListener('pointerleave', function () { shown = false; rt.classList.remove('on'); xy.classList.remove('on'); document.documentElement.classList.remove('rt-active'); });
        (function loop() { rt.classList.toggle('hover', hot()); rx += (x - rx) * 0.5; ry += (y - ry) * 0.5; rt.style.transform = 'translate3d(' + rx + 'px,' + ry + 'px,0)'; xy.style.transform = 'translate3d(' + (rx + 22) + 'px,' + (ry + 18) + 'px,0)'; requestAnimationFrame(loop); })();
      })();
    </script>
    <script is:inline define:vars={{ labels: { reading: t.bar.reading, system: t.bar.system } }}>
      (function () {
        var root = document.documentElement;
        var label = document.getElementById('mode-label');
        var btn = document.getElementById('mode-toggle');
        function paint() {
          var dark = root.dataset.mode === 'dark';
          label.textContent = dark ? labels.system : labels.reading;
          btn.setAttribute('aria-pressed', String(dark));
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', dark ? '#0a0f12' : '#e8edec');
        }
        function setMode(next, x, y) {
          var apply = function () { root.dataset.mode = next; try { localStorage.setItem('mmc-mode', next); } catch (e) {} paint(); };
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!document.startViewTransition || reduce) { apply(); return; }
          var t = document.startViewTransition(apply);
          t.ready.then(function () {
            var r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
            root.animate({ clipPath: ['circle(0px at ' + x + 'px ' + y + 'px)', 'circle(' + r + 'px at ' + x + 'px ' + y + 'px)'] },
              { duration: 650, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', pseudoElement: '::view-transition-new(root)' });
          }).catch(function () {});
        }
        btn.addEventListener('click', function () { var r = btn.getBoundingClientRect(); setMode(root.dataset.mode === 'dark' ? 'light' : 'dark', r.left + r.width / 2, r.top + r.height / 2); });
        paint();
      })();
    </script>
      <script>
      const els = document.querySelectorAll<HTMLElement>('[data-scene]');
      if (els.length) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            io.unobserve(e.target);
            const el = e.target as HTMLElement;
            import('../lib/scenes.js')
              .then(({ mount }) => mount(el, el.dataset.scene as string, { visited: JSON.parse(el.dataset.visited || '[]'), mapUrl: '/world.svg', portrait: el.dataset.portrait || '' }))
              .catch(() => { el.hidden = true; });
          });
        }, { rootMargin: '200px' });
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
