---
import { VISITED, T, type Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const h = T[lang].home;
const en = lang === 'en';
---
<div class="room-wrap">
  <div class="stage">
    <div class="scene scene-room" data-scene="room" data-visited={JSON.stringify(VISITED)}>
      <canvas aria-hidden="true"></canvas>
    </div>
    <nav class="room-labels" aria-label={en ? 'Projects and sections' : 'Proyectos y secciones'}>
      {h.room.map((r) => (
        <a data-station={r.id} href={r.href}><b>{r.label}</b><span>{r.status}</span></a>
      ))}
    </nav>
    <div class="stage-fig">
      <span class="beam" aria-hidden="true"></span>
      <a class="fig-link" href={`/${lang}/about/`} aria-label={en ? 'About me' : 'Sobre mí'}>
        <img src="/img/marcos-character.webp" alt={en ? 'Illustration of Marcos: curly hair, amber glasses, cream knit and trousers' : 'Ilustración de Marcos: pelo rizado, gafas ámbar, jersey y pantalón crema'} width="380" height="1148" loading="eager" decoding="async" />
        <span class="scan" aria-hidden="true"></span>
      </a>
      <span class="base" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="base front" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="motes" aria-hidden="true">{[8,22,36,50,64,78,92,15,70].map((x, i) => <i style={`--x:${x}%;--d:${3.4 + (i % 4) * 0.9}s;--dl:${(i * 0.55).toFixed(2)}s`}></i>)}</span>
      <a class="fig-tag" href={`/${lang}/about/`}><span>{en ? 'Get to know me' : 'Conóceme mejor'}</span><i aria-hidden="true">→</i></a>
    </div>
  </div>
</div>
