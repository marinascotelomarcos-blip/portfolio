---
import { CREDS } from '../lib/creds';
import type { Lang } from '../lib/content';
interface Props { lang: Lang; heading?: 'h1' | 'h2' }
const { lang } = Astro.props;
const k = CREDS[lang];
---
<section class="creds" id="credentials" aria-labelledby="creds-t">
  <header class="creds-head">
    <h2 class="sec" id="creds-t">{k.title}</h2>
    <p class="muted">{k.sub}</p>
  </header>
  <ul class="flags">
    {k.langs.map((l, i) => (
      <li class="holo" data-holo style={`--i:${i}`}>
        <div class="flag" aria-hidden="true">
          {l.id === 'es' && (
            <svg viewBox="0 0 60 40" preserveAspectRatio="none"><rect width="60" height="40" fill="#c60b1e" /><rect y="10" width="60" height="20" fill="#ffc400" /></svg>
          )}
          {l.id === 'gl' && (
            <svg viewBox="0 0 60 40" preserveAspectRatio="none"><rect width="60" height="40" fill="#f4f7f8" /><polygon points="0,0 13,0 60,33 60,40 47,40 0,7" fill="#0b8fd0" /></svg>
          )}
          {l.id === 'en' && (
            <svg viewBox="0 0 60 40" preserveAspectRatio="none"><rect width="60" height="40" fill="#1b2d7a" /><path d="M0 0L60 40M60 0L0 40" stroke="#fff" stroke-width="7" /><path d="M0 0L60 40M60 0L0 40" stroke="#c8102e" stroke-width="2.4" /><path d="M30 0V40M0 20H60" stroke="#fff" stroke-width="12" /><path d="M30 0V40M0 20H60" stroke="#c8102e" stroke-width="7" /></svg>
          )}
          <i class="sheen"></i>
        </div>
        <div class="flag-meta">
          <b>{l.name}</b>
          <span class="mono">{l.level}</span>
          <span class="bars" aria-hidden="true">{[0, 1, 2, 3, 4].map((n) => <i class:list={[n < l.bars && 'on']} style={`--n:${n}`}></i>)}</span>
        </div>
      </li>
    ))}
  </ul>

  <div class="cards">
    <article class="holo card ielts" data-holo>
      <i class="sheen"></i>
      <p class="mono muted">{k.ielts.label}</p>
      <h3>{k.ielts.name}</h3>
      <div class="score"><span class="num tnum">{k.ielts.score}</span><span class="mono muted">{k.ielts.band}</span></div>
      <div class="band" aria-hidden="true">{Array.from({ length: 9 }, (_, n) => <i class:list={[n < 6 && 'on']}></i>)}</div>
      <p class="mono muted">{k.ielts.meta}</p>
    </article>
    <article class="holo card licence" data-holo>
      <i class="sheen"></i>
      <span class="chip" aria-hidden="true"></span>
      <p class="mono muted">{k.licence.label}</p>
      <div class="cat"><span>{k.licence.cat}</span><small class="mono">{k.licence.meta}</small></div>
      <p class="hint">{k.licence.hint}</p>
      <svg class="emb" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="17" fill="none" stroke="currentColor" stroke-width="1.2" /><circle cx="20" cy="20" r="11" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3" /><path d="M20 7v26M7 20h26" stroke="currentColor" stroke-width="0.8" /></svg>
    </article>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-holo]').forEach((el) => {
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
      el.style.setProperty('--ry', ((x - 0.5) * 16).toFixed(1) + 'deg');
      el.style.setProperty('--rx', ((0.5 - y) * 16).toFixed(1) + 'deg');
      el.style.setProperty('--hx', (x * 100).toFixed(0) + '%');
      el.style.setProperty('--hy', (y * 100).toFixed(0) + '%');
      el.classList.add('hot');
    });
    el.addEventListener('pointerleave', () => { el.style.setProperty('--rx', '0deg'); el.style.setProperty('--ry', '0deg'); el.classList.remove('hot'); });
  });
</script>
