---
import { ABOUTX } from '../lib/aboutx';
import type { Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const k = ABOUTX[lang];
const hue: Record<string, string> = { es: '#c60b1e', gl: '#0b8fd0', en: '#1b2d7a', ielts: '#0f7077', b: '#0f7077' };
---
<section class="creds" id="credentials" aria-labelledby="creds-t">
  <h2 class="sec" id="creds-t">{k.cred}</h2>
  <ul class="tiles creds-tiles">
    {k.tiles.map((t, i) => (
      <li style="display:contents">
        <div class="tile" data-tile style={`--c:${hue[t.id]};--i:${i}`}>
          <span class="tile-ico cred-ico" aria-hidden="true">
            {t.id === 'es' && <svg viewBox="0 0 60 40" preserveAspectRatio="none"><rect width="60" height="40" fill="#c60b1e" /><rect y="10" width="60" height="20" fill="#ffc400" /></svg>}
            {t.id === 'gl' && <svg viewBox="0 0 60 40" preserveAspectRatio="none"><rect width="60" height="40" fill="#f4f7f8" /><polygon points="0,0 13,0 60,33 60,40 47,40 0,7" fill="#0b8fd0" /></svg>}
            {t.id === 'en' && <svg viewBox="0 0 60 40" preserveAspectRatio="none"><rect width="60" height="40" fill="#1b2d7a" /><path d="M0 0L60 40M60 0L0 40" stroke="#fff" stroke-width="7" /><path d="M0 0L60 40M60 0L0 40" stroke="#c8102e" stroke-width="2.4" /><path d="M30 0V40M0 20H60" stroke="#fff" stroke-width="12" /><path d="M30 0V40M0 20H60" stroke="#c8102e" stroke-width="7" /></svg>}
            {'badge' in t && <b class="badge mono">{t.badge}</b>}
            <i class="sheen"></i>
          </span>
          <span class="tile-name">{t.name}<small class="tile-sub">{t.sub}</small></span>
        </div>
      </li>
    ))}
  </ul>
</section>
<script>
  document.querySelectorAll<HTMLElement>('.creds-tiles [data-tile]').forEach((el) => {
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
      el.style.setProperty('--ry', (x * 14).toFixed(1) + 'deg'); el.style.setProperty('--rx', (-y * 14).toFixed(1) + 'deg');
      el.style.setProperty('--mx', ((x + 0.5) * 100).toFixed(0) + '%'); el.style.setProperty('--my', ((y + 0.5) * 100).toFixed(0) + '%');
    });
    el.addEventListener('pointerleave', () => { el.style.setProperty('--rx', '0deg'); el.style.setProperty('--ry', '0deg'); });
  });
</script>
