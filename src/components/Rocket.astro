---
/* Marcos's rocket: rendered from his 3D model (mmc_rocket_3d.glb) as two aligned transparent images, body and flame */
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<span class:list={['rocket-svg', cls]} aria-hidden="true">
  <i class="rk-glow"></i>
  <img class="rk-flame" src="/img/rocket-flame.png" alt="" width="512" height="1024" decoding="async" />
  <img class="rk-body" src="/img/rocket-body.png" alt="" width="512" height="1024" decoding="async" />
</span>
