---
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<svg class:list={['rocket-svg', cls]} viewBox="0 0 60 150" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="rk-body" x1="0" x2="1"><stop offset="0" stop-color="#cfdcde" /><stop offset=".45" stop-color="#f6fbfb" /><stop offset="1" stop-color="#b4c6c9" /></linearGradient>
    <linearGradient id="rk-fl" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff6c9" /><stop offset=".35" stop-color="#ffb84a" /><stop offset="1" stop-color="#e0502a" stop-opacity="0" /></linearGradient>
  </defs>
  <g class="rk-flame">
    <path d="M30 100 C42 112 40 134 30 150 C20 134 18 112 30 100Z" fill="url(#rk-fl)" />
    <path d="M30 100 C37 110 36 124 30 136 C24 124 23 110 30 100Z" fill="#fff6c9" opacity=".95" />
  </g>
  <path d="M14 76 L1 110 L15 100Z" fill="#e0703a" />
  <path d="M46 76 L59 110 L45 100Z" fill="#e0703a" />
  <rect x="21" y="97" width="18" height="7" rx="2" fill="#4c5a60" />
  <path d="M30 3 C44 22 48 54 46 99 L14 99 C12 54 16 22 30 3Z" fill="url(#rk-body)" />
  <path d="M30 3 C37 11 41 21 43 32 L17 32 C19 21 23 11 30 3Z" fill="#0f7077" />
  <rect x="15" y="82" width="30" height="5" fill="#0f7077" opacity=".85" />
  <circle cx="30" cy="57" r="9.5" fill="#0a1a20" stroke="#3bb8be" stroke-width="3" />
  <path d="M25.5 53.5 a6 6 0 0 1 5-2.6" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".75" />
</svg>
