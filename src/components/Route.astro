---
import { VISITED, T, EMAIL, CV, type Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const h = T[lang].home;
const a = T[lang].about;
const ui = h.routeUi;
const rn = h.routeNext;

// Everything below comes from content.ts (route, education and experience); nothing is added here.
const [cal, san, cor, poz, next] = h.route;
const edu = a.edu; // 0 UIE, 1 Erasmus, 2 Peleteiro, 3 Monterey Bay
const exp = a.exp; // 0 GESTEMCO, 1 ALEXCLA, 2 Pescados Océano, 3 Paca Hostelería
const short = ['GESTEMCO', 'ALEXCLA', 'Pescados Océano', 'Paca Hostelería'];

type Item = { kind: 'study' | 'work' | 'next'; when: string; title: string; line: string; text?: string; node: string; lat?: number; lon?: number };
const work = (i: number): Item => ({ kind: 'work', when: exp[i].when, title: exp[i].role, line: exp[i].org, text: exp[i].what, node: short[i] });
const items: Item[] = [
  { kind: 'study', when: cal.when, title: cal.where, line: edu[3].org, text: edu[3].title, node: cal.where, lat: cal.lat, lon: cal.lon },
  { kind: 'study', when: san.when, title: san.where, line: edu[2].org, text: edu[2].title, node: san.where, lat: san.lat, lon: san.lon },
  { kind: 'study', when: cor.when, title: cor.where, line: edu[0].org, text: edu[0].title + ' · ' + edu[0].when, node: cor.where, lat: cor.lat, lon: cor.lon },
  work(3),
  work(2),
  work(1),
  { kind: 'study', when: edu[1].when, title: poz.where, line: edu[1].org, text: edu[1].title, node: poz.where, lat: poz.lat, lon: poz.lon },
  work(0),
];
const powerLabel = lang === 'en' ? 'Launch charge' : 'Carga de despegue';
const hint = lang === 'en' ? 'Use the arrows: every stop charges the rocket.' : 'Usa las flechas: cada parada carga el cohete.';
const kindLabel = { study: ui.study, work: ui.work, next: ui.next };
const stops = items.map((i) => (i.lat !== undefined ? { lat: i.lat, lon: i.lon } : null));
const kinds = items.map((i) => i.kind);
---
<div class="tour" data-tour>
  <div class="tour-card-wrap">
    <div class="stops">
    {items.map((it, i) => (
      <article class="stop-card" id={`stop-${i}`} role="tabpanel" aria-labelledby={`node-${i}`} data-kind={it.kind} hidden={i !== 0}>
        <span class="stop-kind mono">{kindLabel[it.kind]} · <span class="tnum">{it.when}</span></span>
        {(
          <>
            <h3>{it.title}</h3>
            <p class="stop-line">{it.line}</p>
            {it.text && <p class="stop-text">{it.text}</p>}
          </>
        )}
      </article>
    ))}
    </div>
    <div class="tour-controls">
      <div class="power" data-power role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label={powerLabel}>
        <span class="power-top mono"><span>{powerLabel}</span><b class="power-pct tnum">0%</b></span>
        <span class="power-track"><i></i></span>
      </div>
      <span class="tour-hint mono">{hint}</span>
    </div>
  </div>
  <div class="tour-globe">
    <div class="scene scene-route" data-scene="route" data-step="0" data-stops={JSON.stringify(stops)} data-kinds={JSON.stringify(kinds)} data-visited={JSON.stringify(VISITED)} aria-hidden="true"><canvas></canvas></div>
    <div class="globe-nav">
      <button class="tc gn" type="button" data-prev aria-label={ui.prev}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 5.5L8 12l6.5 6.5" /></svg>
      </button>
      <button class="tc gn" type="button" data-next aria-label={ui.nextStop}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 5.5L16 12l-6.5 6.5" /></svg>
      </button>
    </div>
  </div>
</div>
<div class="tour-track-wrap" data-tour-track>
  <div class="track" style={`--n:${items.length}`}>
   <div class="track-in" role="tablist" aria-label={ui.stops}>
    <div class="track-line" aria-hidden="true">
      <i class="track-fill"></i>
      <span class="plane" aria-hidden="true"><i></i></span>
    </div>
    {items.map((it, i) => (
      <button class:list={['node', i === 0 && 'on']} type="button" role="tab" id={`node-${i}`} aria-controls={`stop-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-i={i} data-kind={it.kind}>
        <i class="dot"></i>
        <span class="nw">{it.when}</span>
        <b class="nn">{it.node}</b>
      </button>
    ))}
   </div>
  </div>
</div>
<script>
  const root = document.querySelector<HTMLElement>('[data-tour]');
  const trackWrap = document.querySelector<HTMLElement>('[data-tour-track]');
  if (root && trackWrap) {
    const scene = root.querySelector<HTMLElement>('[data-scene]')!;
    const stopsEl = root.querySelector<HTMLElement>('.stops')!;
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.stop-card'));
    const nodes = Array.from(trackWrap.querySelectorAll<HTMLButtonElement>('.node'));
    const track = trackWrap.querySelector<HTMLElement>('.track')!;
    const line = trackWrap.querySelector<HTMLElement>('.track-line')!;
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const power = root.querySelector<HTMLElement>('[data-power]')!;
    const powerFill = power.querySelector<HTMLElement>('.power-track i')!;
    const powerPct = power.querySelector<HTMLElement>('.power-pct')!;
    const N = nodes.length;
    const en = document.documentElement.lang.startsWith('en');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0, visible = false;
    type Phase = 'idle' | 'count' | 'fly';
    let phase: Phase = 'idle', abort = false, pending = 0;
    let overlay: HTMLElement | null = null;

    /* The card area is exactly as tall as the stop on show, so no gap opens above the timeline */
    function fit() { stopsEl.style.height = cards[cur].offsetHeight + 'px'; }
    const sizer = new ResizeObserver(() => fit());
    cards.forEach((c) => sizer.observe(c));

    function show(i: number) {
      cur = Math.max(0, Math.min(N - 1, i));
      scene.dataset.step = String(cur);
      cards.forEach((c, k) => { c.hidden = k !== cur; });
      nodes.forEach((n, k) => {
        n.setAttribute('aria-selected', String(k === cur));
        n.tabIndex = k === cur ? 0 : -1;
        n.classList.toggle('past', k < cur);
      });
      const p = cur / (N - 1);
      line.style.setProperty('--p', String(p));
      line.dataset.kind = nodes[cur].dataset.kind || '';
      track.scrollTo({ left: nodes[cur].offsetLeft - track.clientWidth / 2 + nodes[cur].clientWidth / 2, behavior: reduce ? 'auto' : 'smooth' });
      fit();
      /* launch charge: fills as you move along the route and is full on the last stop */
      powerFill.style.transform = `scaleX(${p})`;
      powerPct.textContent = Math.round(p * 100) + '%';
      power.setAttribute('aria-valuenow', String(Math.round(p * 100)));
      power.classList.toggle('full', cur === N - 1);
      root!.classList.toggle('ready', cur === N - 1);
      prevBtn.disabled = cur === 0;
      if (phase === 'count') cancelCountdown();
      window.clearTimeout(pending);
      if (cur === N - 1 && visible && !reduce && phase === 'idle') pending = window.setTimeout(startCountdown, 1000);
    }

    nodes.forEach((n, k) => {
      n.addEventListener('click', () => { if (phase !== 'fly') show(k); });
      n.addEventListener('keydown', (e) => {
        if (phase === 'fly') return;
        if (e.key === 'ArrowRight') { e.preventDefault(); show(cur + 1); nodes[cur].focus(); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); show(cur - 1); nodes[cur].focus(); }
      });
    });
    prevBtn.addEventListener('click', () => { if (phase !== 'fly') show(cur - 1); });
    nextBtn.addEventListener('click', () => {
      if (phase === 'fly') return;
      if (cur === N - 1) { window.clearTimeout(pending); if (phase === 'idle' && !reduce) startCountdown(); }
      else show(cur + 1);
    });
    new IntersectionObserver((es) => {
      visible = es[0].isIntersecting;
      if (!visible && phase === 'count') cancelCountdown();
      if (visible && cur === N - 1 && phase === 'idle' && !reduce) { window.clearTimeout(pending); pending = window.setTimeout(startCountdown, 1000); }
    }, { threshold: 0.35 }).observe(root);

    /* ================= Lift-off =================
       Full charge starts 3, 2, 1. The rocket is Marcos's real 3D model, rendered live:
       it rises out of the planet nose-first TOWARD the camera (true perspective, it grows because it comes closer),
       pitches over to look down, drifts past the 2027 planet, loops slowly over the text so it can be read,
       then swoops down and lands softly on the pad. One continuous path; the camera follows downward only.
       It is a quiet guide, not the star of the page. */
    const space = document.getElementById('space');
    const CS = 180; // rocket canvas, CSS px
    const rad = (d: number) => (d * Math.PI) / 180;
    let rocketLib: Promise<any> | null = null;
    const loadRocketLib = () => (rocketLib ||= import('../lib/rocket3d.js'));

    function cancelCountdown() {
      window.clearTimeout(pending);
      cdTimers.forEach((t) => window.clearTimeout(t)); cdTimers = [];
      overlay?.remove(); overlay = null;
      if (phase === 'count') phase = 'idle';
    }
    let cdTimers: number[] = [];
    function startCountdown() {
      if (reduce || !space || phase !== 'idle') return;
      phase = 'count';
      loadRocketLib(); // fetch the 3D code and model while the numbers run
      overlay = document.createElement('div');
      overlay.className = 'cd-fs';
      overlay.setAttribute('aria-hidden', 'true');
      overlay.innerHTML = `<span class="cd-label mono">${en ? 'Lift-off in' : 'Despegue en'}</span><b class="cd-num"></b><i class="cd-ring"></i>`;
      document.body.appendChild(overlay);
      requestAnimationFrame(() => overlay?.classList.add('in'));
      const num = overlay.querySelector<HTMLElement>('.cd-num')!;
      const tick = (txt: string, go = false) => { num.textContent = txt; num.classList.remove('slam'); overlay!.classList.remove('pulse'); void num.offsetWidth; num.classList.add('slam'); overlay!.classList.add('pulse'); overlay!.classList.toggle('go', go); };
      ['3', '2', '1'].forEach((t, k) => cdTimers.push(window.setTimeout(() => tick(t), 150 + k * 700)));
      cdTimers.push(window.setTimeout(() => { tick(en ? 'GO!' : '¡YA!', true); cdTimers.push(window.setTimeout(() => { cdTimers = []; launch(); }, 380)); }, 150 + 3 * 700));
    }

    type Pt = { x: number; y: number };
    const smooth = (u: number) => { u = Math.max(0, Math.min(1, u)); return u * u * (3 - 2 * u); };
    const easeOut3 = (u: number) => 1 - Math.pow(1 - Math.max(0, Math.min(1, u)), 3);

    async function launch() {
      if (!space) return;
      phase = 'fly'; abort = false;
      overlay?.classList.add('out'); const ov = overlay; overlay = null; window.setTimeout(() => ov?.remove(), 700);
      document.querySelector('.rocket-parked')?.remove();
      document.getElementById('rocket-trail')?.remove();
      document.querySelector('.hb-pad')?.classList.remove('lit');
      const planet = space.querySelector<HTMLElement>('.planet')!;
      const row = document.querySelector<HTMLElement>('.hb-row.main')!;
      const links = row.parentElement as HTMLElement;
      const pad = links.querySelector<HTMLElement>('.hb-pad')!;
      const html = document.documentElement;

      // the 3D rocket; if WebGL or the model is unavailable, the page simply scrolls down to 2027
      let lib: any, rk: any;
      try { lib = await loadRocketLib(); rk = await lib.createRocket({ size: CS }); }
      catch (e) { phase = 'idle'; show(0); space.scrollIntoView({ behavior: 'smooth', block: 'start' }); return; }
      const V3 = (x: number, y: number, z: number) => ({ x, y, z });
      const THREE_V = rk.nose(); // a THREE.Vector3 we can reuse
      const NOZ = (lib.BODY_LEN / 2) / lib.UNITS_PER_CANVAS * CS; // px from the rocket's centre to its nozzle at normal depth
      const persp = (z: number) => 15.5 / (15.5 - z);              // on-screen size factor at depth z

      html.classList.add('flying');
      const prevBehavior = html.style.scrollBehavior; html.style.scrollBehavior = 'auto'; // the page has smooth scrolling in CSS; the camera must not be smoothed twice
      // any scroll gesture from the visitor cancels the flight (the page is never held hostage); the rocket just parks on the pad
      let userScrolled = false;
      const block = () => { userScrolled = true; abort = true; };
      window.addEventListener('wheel', block, { passive: true }); window.addEventListener('touchmove', block, { passive: true });
      const skip = document.createElement('button');
      skip.type = 'button'; skip.className = 'fly-skip mono'; skip.textContent = en ? 'Skip ↓' : 'Saltar ↓';
      skip.addEventListener('click', () => { abort = true; });
      const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape') abort = true; };
      window.addEventListener('keydown', onKey);
      document.body.appendChild(skip);

      const W = window.innerWidth, H = window.innerHeight;
      const dr = (el: HTMLElement) => { const r = el.getBoundingClientRect(); return { x: r.left + window.scrollX, y: r.top + window.scrollY, w: r.width, h: r.height }; };
      const docH = html.scrollHeight, maxScroll = Math.max(0, docH - H);

      const trail = document.createElement('div');
      trail.id = 'rocket-trail'; trail.style.height = docH + 'px';
      document.body.appendChild(trail);

      /* smoke: one fixed canvas, particles live in document coordinates */
      const cv = document.createElement('canvas'); cv.className = 'fly-smoke';
      cv.width = W; cv.height = H;
      document.body.appendChild(cv);
      const ctx = cv.getContext('2d')!;
      const sprite = (c0: string, c1: string) => { const s = document.createElement('canvas'); s.width = s.height = 64; const x = s.getContext('2d')!; const gr = x.createRadialGradient(28, 28, 2, 32, 32, 31); gr.addColorStop(0, c0); gr.addColorStop(1, c1); x.fillStyle = gr; x.fillRect(0, 0, 64, 64); return s; };
      const puffSp = sprite('rgba(255,255,255,.95)', 'rgba(200,214,218,0)'), fireSp = sprite('rgba(255,236,170,1)', 'rgba(255,110,30,0)');
      type Pa = { x: number; y: number; vx: number; vy: number; t0: number; life: number; s0: number; s1: number; a: number; fire: boolean };
      let parts: Pa[] = [];
      const addPart = (x: number, y: number, fire: boolean, t: number, k = 1, al = 0.5) => {
        if (parts.length > 80) return;
        parts.push({ x: x + (Math.random() - 0.5) * 8, y, vx: (Math.random() - 0.5) * (fire ? 60 : 34), vy: (fire ? 40 : 18) + Math.random() * 30, t0: t, life: fire ? 380 : 800 + Math.random() * 500, s0: fire ? 8 : 10, s1: (fire ? 3 : 26 + Math.random() * 16) * k, a: fire ? 1 : al, fire });
      };
      const drawParts = (t: number, cam: number) => {
        ctx.clearRect(0, 0, W, H);
        parts = parts.filter((p) => t - p.t0 < p.life);
        for (const p of parts) {
          const u = (t - p.t0) / p.life, e = 1 - (1 - u) * (1 - u), sz = p.s0 + (p.s1 - p.s0) * e;
          ctx.globalAlpha = p.a * (1 - u) * (p.fire ? 1 : Math.min(1, u * 8));
          ctx.drawImage(p.fire ? fireSp : puffSp, p.x + p.vx * e * 1.4 - sz, p.y + p.vy * e * 1.4 - cam - sz, sz * 2, sz * 2);
        }
        ctx.globalAlpha = 1;
      };

      /* ---- the path, built once in document coordinates ---- */
      const g = dr(scene), S: Pt = { x: g.x + g.w / 2, y: g.y + g.h * 0.5 };
      const pl = dr(planet);
      const kindR = dr(space.querySelector<HTMLElement>('.space-kind')!), countR = dr(space.querySelector<HTMLElement>('.space-count')!);
      const zt = kindR.y, zb = countR.y + countR.h, zh = zb - zt;
      const pd = dr(pad);
      const Lp: Pt = { x: pd.x + pd.w * 0.5, y: pd.y - NOZ + 3 };
      const Q0: Pt = { x: W * 0.8, y: zt - 24 };
      const Xe: Pt = { x: W * 0.36, y: zt + zh + 30 };
      const ctrl: Pt[] = [
        S,
        { x: S.x + 2, y: S.y + 36 },
        { x: S.x + 0.14 * W, y: S.y + 0.26 * H },
        { x: S.x + (Q0.x - S.x) * 0.66, y: S.y + (Q0.y - S.y) * 0.62 },
        Q0,
      ];
      const iZ0 = ctrl.length - 1;
      // slow loop-the-loop over the text: forward drift plus one full circle with eased ends (so the path stays smooth)
      const R = Math.max(46, Math.min(W * 0.15, zh * 0.26, 118));
      const ZN = 30;
      for (let i = 1; i <= ZN; i++) {
        const u = i / ZN, f = smooth(u), th = Math.PI * 2 * smooth((u - 0.12) / 0.76);
        ctrl.push({ x: Q0.x + (Xe.x - Q0.x) * f + R * (Math.cos(th) - 1), y: Q0.y + (Xe.y - Q0.y) * f + R * Math.sin(th) });
      }
      const iZ1 = ctrl.length - 1;
      ctrl.push({ x: Lp.x - 24, y: Math.max(zb + 110, Lp.y - 0.44 * H) });
      ctrl.push(Lp);
      type Node = { p: Pt; seg: 0 | 1 | 2; u: number };
      const nodes: Node[] = [];
      const cr = (p0: Pt, p1: Pt, p2: Pt, p3: Pt, t: number): Pt => { const t2 = t * t, t3 = t2 * t; const f = (a: number, b: number, c: number, d: number) => 0.5 * ((2 * b) + (-a + c) * t + (2 * a - 5 * b + 4 * c - d) * t2 + (-a + 3 * b - 3 * c + d) * t3); return { x: f(p0.x, p1.x, p2.x, p3.x), y: f(p0.y, p1.y, p2.y, p3.y) }; };
      for (let k = 0; k < ctrl.length - 1; k++) {
        const p0 = ctrl[Math.max(0, k - 1)], p1 = ctrl[k], p2 = ctrl[k + 1], p3 = ctrl[Math.min(ctrl.length - 1, k + 2)];
        const seg: 0 | 1 | 2 = k < iZ0 ? 0 : (k < iZ1 ? 1 : 2);
        const samp = seg === 1 ? 5 : 26;
        const segStart = seg === 0 ? 0 : seg === 1 ? iZ0 : iZ1, segLen = seg === 0 ? iZ0 : seg === 1 ? iZ1 - iZ0 : ctrl.length - 1 - iZ1;
        for (let i = (k === 0 ? 0 : 1); i <= samp; i++) nodes.push({ p: cr(p0, p1, p2, p3, i / samp), seg, u: Math.min(1, ((k - segStart) + i / samp) / segLen) });
      }
      const n = nodes.length;
      const cum: number[] = [0];
      for (let i = 1; i < n; i++) cum.push(cum[i - 1] + Math.hypot(nodes[i].p.x - nodes[i - 1].p.x, nodes[i].p.y - nodes[i - 1].p.y));
      const total = cum[n - 1];
      const iz0 = nodes.findIndex((q) => q.seg === 1), iz1 = n - 1 - [...nodes].reverse().findIndex((q) => q.seg === 1);
      const sZ0 = cum[iz0], sZ1 = cum[iz1];
      // speed along the path: eases out of the launch, glides slowly over the text, eases into the landing
      const speedAt = (s: number) => {
        const acc = smooth(s / (total * 0.12)), dec = smooth((total - s) / (total * 0.2));
        let v = 0.1 + 0.9 * Math.min(acc, dec);
        const w = total * 0.04, bump = smooth((s - (sZ0 - w)) / (2 * w)) * (1 - smooth((s - (sZ1 - w)) / (2 * w)));
        v *= 1 - 0.6 * bump;
        return v;
      };
      const tm: number[] = [0];
      for (let i = 1; i < n; i++) { const s = (cum[i] + cum[i - 1]) / 2; tm.push(tm[i - 1] + (cum[i] - cum[i - 1]) / Math.max(0.04, speedAt(s))); }
      const FLIGHT = 9200; // ms after the 700 ms ignition
      const tmk = FLIGHT / tm[n - 1]; for (let i = 0; i < n; i++) tm[i] *= tmk;
      // unit direction of travel per node (smoothed over neighbours)
      const hdg: Pt[] = [];
      for (let i = 0; i < n; i++) {
        const a = nodes[Math.max(0, i - 4)].p, b = nodes[Math.min(n - 1, i + 4)].p;
        const dx = b.x - a.x, dy = b.y - a.y, l = Math.hypot(dx, dy) || 1;
        hdg.push({ x: dx / l, y: dy / l });
      }

      /* ---- rocket canvas ---- */
      const cvs: HTMLCanvasElement = rk.canvas;
      cvs.className = 'rocket-gl';
      cvs.style.width = CS + 'px'; cvs.style.height = CS + 'px';
      cvs.style.opacity = '0';
      document.body.appendChild(cvs);
      root!.classList.add('liftoff');
      const put = (x: number, y: number) => { cvs.style.transform = `translate3d(${x}px, ${y}px, 0)`; };
      let parked = false, scenePaused = false;
      const park = (P: Pt, img: string) => {
        const lk = dr(links);
        const el = document.createElement('div');
        el.className = 'rocket-parked';
        el.style.left = (P.x - lk.x) + 'px'; el.style.top = (P.y - lk.y) + 'px';
        const im = document.createElement('img'); im.src = img; im.alt = ''; im.width = CS; im.height = CS;
        el.appendChild(im);
        links.appendChild(el); parked = true;
      };
      let persist = 0, lastEmit = 0;
      const trailCloud = (tp: Pt) => {
        const c = document.createElement('i'); c.className = 'cloud';
        c.style.cssText = `left:${tp.x + (Math.random() - 0.5) * 18}px;top:${tp.y + (Math.random() - 0.5) * 12}px;--cs:${0.8 + Math.random() * 0.9}`;
        trail.appendChild(c);
      };
      const finish = () => {
        html.style.scrollBehavior = prevBehavior; html.classList.remove('flying'); scene.style.transform = '';
        window.removeEventListener('wheel', block); window.removeEventListener('touchmove', block); window.removeEventListener('keydown', onKey);
        skip.remove(); rk.dispose();
        root!.classList.remove('liftoff'); phase = 'idle';
        window.setTimeout(() => cv.remove(), 1400);
        show(0);
      };

      /* ---- one loop: rocket, camera, smoke ---- */
      let cam = window.scrollY, camVel = 0, tPrev = performance.now();
      const startScroll = window.scrollY;
      const zoneView = zt - H * 0.18;
      const camTarget = (idx: number, P: Pt) => {
        const nd = nodes[idx];
        let target: number;
        if (nd.seg === 1) target = zoneView;                                  // over the text: hold it in view
        else if (nd.seg === 2) { const k = smooth(nd.u * 1.2), t1 = zoneView + (P.y - H * 0.5 - zoneView) * smooth(nd.u / 0.3); target = t1 * (1 - k) + (Lp.y - H * 0.6) * k; }
        else { const k = smooth((nd.u - 0.7) / 0.3); target = Math.max(startScroll, P.y - H * 0.5) * (1 - k) + zoneView * k; } // before the text: only ever follows downward
        return Math.max(0, Math.min(maxScroll, target));
      };
      const IGN = 700;
      const t0 = performance.now();
      let touch = 0;
      await new Promise<void>((resolve) => {
        const frame = (now: number) => {
          const dt = Math.min(64, now - tPrev); tPrev = now;
          const T = now - t0, dts = dt / 1000;
          if (abort) { resolve(); return; }
          let P: Pt, idx = 0, tt = 0, land = 0, hx = 0, hy = 1;
          if (T < IGN) {
            P = { x: S.x, y: S.y }; tt = 0;
            cvs.style.opacity = '1';
          } else {
            tt = Math.min(FLIGHT, T - IGN);
            let lo = 0, hi = n - 1;
            while (hi - lo > 1) { const mid = (lo + hi) >> 1; if (tm[mid] <= tt) lo = mid; else hi = mid; }
            const f = tm[hi] > tm[lo] ? (tt - tm[lo]) / (tm[hi] - tm[lo]) : 0;
            idx = f > 0.5 ? hi : lo;
            P = { x: nodes[lo].p.x + (nodes[hi].p.x - nodes[lo].p.x) * f, y: nodes[lo].p.y + (nodes[hi].p.y - nodes[lo].p.y) * f };
            hx = hdg[lo].x + (hdg[hi].x - hdg[lo].x) * f; hy = hdg[lo].y + (hdg[hi].y - hdg[lo].y) * f;
            land = smooth((cum[lo] / total - 0.8) / 0.16);
            // camera: a critically-damped spring that follows the rocket
            const target = camTarget(idx, P), wc = 5.2;
            camVel += (wc * wc * (target - cam) - 2 * wc * camVel) * dts; camVel = Math.max(-2600, Math.min(2600, camVel));
            cam = Math.max(0, Math.min(maxScroll, cam + camVel * dts));
            window.scrollTo(0, cam);
            if (!scenePaused && cam > g.y + g.h + 30) { scenePaused = true; scene.style.transform = 'translateY(-99999px)'; } // once the globe is off screen, stop its renderer: the GPU is needed here
          }
          /* orientation (world: x right, y up, z toward the viewer).
             Start: nose pointing at the camera. Then it pitches over to look along its path (down the page), banks through the
             loop, and finally stands up for the landing. */
          const elev = (Math.PI / 2) * (1 - smooth((tt - 600) / 1700));       // 90° = nose at the camera, 0 = flying in the screen plane
          const plane = { x: hx, y: -hy };                                      // screen direction (y down) -> world (y up)
          const upBlend = land;
          let dx = plane.x * (1 - upBlend), dy = plane.y * (1 - upBlend) + upBlend, dz = 0;
          const dl = Math.hypot(dx, dy) || 1; dx /= dl; dy /= dl;
          const ce = Math.cos(elev), se = Math.sin(elev);
          rk.setPose(V3(dx * ce, dy * ce, se), 3.4 * (1 - smooth(tt / 2600)) * (1 - upBlend) + (-0.5) * upBlend);
          rk.update(dts, 0.15);
          // depth: it starts far away inside the planet and comes toward the viewer (real perspective, not a zoom)
          const z = -17 * (1 - easeOut3(tt / 1800));
          rk.setDepth(z);
          const flame = (T < IGN ? 0.8 : 1) * (1 + 0.8 * land);
          rk.setFlame(flame);
          // place: the canvas is centred on the rocket
          const sx = P.x - CS / 2, sy = P.y - cam - CS / 2;
          put(sx + (T < IGN ? (1 - T / IGN) * 1.6 * Math.sin(T * 0.09) : 0), sy);
          rk.render(now);

          // smoke from the tail
          if (now - lastEmit > 30 && (T < IGN || tt > 250)) {
            lastEmit = now;
            rk.nose(THREE_V);
            if (Math.abs(THREE_V.z) < 0.88) {
              const sc = persp(z), tl = (NOZ + 14) * sc;
              const tp: Pt = { x: P.x - THREE_V.x * tl, y: P.y + THREE_V.y * tl };
              const zone = nodes[idx].seg === 1 && T >= IGN;
              const rate = T < IGN ? 1.2 : (zone ? 0.22 : (0.9 + 1.4 * land)) * Math.min(1, 0.4 + sc * 0.6);
              const k = Math.floor(rate + Math.random());
              for (let q = 0; q < k; q++) addPart(tp.x, tp.y, false, now, zone ? 0.5 : 1, zone ? 0.2 : 0.5);
              if (Math.random() < Math.min(0.7, rate * 0.45)) addPart(tp.x, tp.y - 3, true, now);
              if (T >= IGN && ++persist % 8 === 0) trailCloud(tp);
            }
          }
          drawParts(now, cam);
          if (T < IGN + FLIGHT) requestAnimationFrame(frame); else { touch = now; resolve(); }
        };
        requestAnimationFrame(frame);
      });

      if (abort) {
        if (!userScrolled) window.scrollTo(0, Math.max(0, Math.min(maxScroll, Lp.y - H * 0.6)));
        cvs.remove();
        const pdAfter = dr(pad);
        const LpA: Pt = { x: pdAfter.x + pdAfter.w * 0.5, y: pdAfter.y - NOZ + 3 };
        park(LpA, rk.snapshot()); pad.classList.add('lit');
        finish(); return;
      }

      /* touchdown: engine cuts out with a flash and dust, and the rocket stays parked on the pad */
      await new Promise<void>((res) => { const t1 = performance.now(); const f2 = (now: number) => { const u = Math.min(1, (now - t1) / 260); rk.setFlame(1.8 * (1 - u)); rk.update(0.016, 0.15); rk.render(now); drawParts(now, cam); if (u < 1) requestAnimationFrame(f2); else res(); }; requestAnimationFrame(f2); });
      const now2 = performance.now();
      for (let k = 0; k < 22; k++) { const side = k % 2 ? 1 : -1; addPart(pd.x + pd.w / 2 + side * Math.random() * 14, pd.y, k % 3 === 0, now2, 0.8, 0.4); const p = parts[parts.length - 1]; if (p) { p.vx = side * (40 + Math.random() * 110); p.vy = -4 - Math.random() * 16; } }
      const flash = document.createElement('i'); flash.className = 'pad-flash';
      flash.style.cssText = `left:${pd.x + pd.w / 2}px;top:${pd.y}px`;
      document.body.appendChild(flash); flash.addEventListener('animationend', () => flash.remove());
      park(Lp, rk.snapshot()); pad.classList.add('lit');
      cvs.remove();
      const drain = (t: number) => { drawParts(t, window.scrollY); if (parts.length) requestAnimationFrame(drain); };
      requestAnimationFrame(drain);
      finish();
    }
    show(0);
  }
</script>
